# Copy this file to .env.local (git-ignored) and fill in your values. Never commit real keys.

# Option A: OpenAI directly
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Chat Completions tool calling on GPT-6 Luna needs reasoning effort "none". Remove if your model rejects it.
OPENAI_REASONING_EFFORT=none
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option B: AWS Bedrock (comment out Option A, uncomment these)
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=global.openai.gpt-6-luna
# A Bedrock API key (starts with ABSK...) goes here:
# AWS_BEARER_TOKEN_BEDROCK=
# or use standard AWS credentials instead: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
