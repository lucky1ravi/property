# Copy this file to .env.local (git-ignored) and fill in your values. Never commit real keys.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Chat Completions tool calling on GPT-6 Luna needs reasoning effort "none". Remove if your model rejects it.
OPENAI_REASONING_EFFORT=none
# OPENAI_BASE_URL=https://api.openai.com/v1

# To use AWS Bedrock instead:
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=global.openai.gpt-6-luna
# (AWS credentials come from the standard AWS chain: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or aws configure)
