# Where the web app and API are. Defaults target the local stack from tools/local-stack.sh.
E2E_BASE_URL=http://localhost:4173
E2E_API_URL=http://localhost:4173
# The shared demo password every seeded demo user has (shown on the sign-in page of a demo environment).
E2E_DEMO_PASSWORD=PropertyOS@2026
# local = tests may create companies and users. live = read-only checks only (never creates accounts).
E2E_MODE=local
